[sub_resource type="GDScript" id="GDScript_cms5r"]
script/source = "extends Control

enum Menu {
	SETTINGS,
	CREDITS,
	HELP
}
var menus: Array[int] = []

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	$PlayButton.pressed.connect(play)
	
	# Popup toggle buttons
	$SettingsButton.pressed.connect(func(): show_first_menu(Menu.SETTINGS))
	$CreditsButton.pressed.connect(func(): show_first_menu(Menu.CREDITS))
	$HelpButton.pressed.connect(func(): show_first_menu(Menu.HELP))
	
	# Menu back button
	$PopupBackground/Popup/BackButton.pressed.connect(
		func():
			match menus.size():
				0: return
				1: hide_menu()
				_:
					var latest_page: int = menus.size() - 1
					var latest_page_node: Control = $PopupBackground/Popup/Pages.get_child(menus.get(latest_page))
					latest_page_node.hide()
					print(\"Hiding Node: \", latest_page_node)
					menus.remove_at(latest_page)
					show_menu(menus[-1])
	)
	
	# Settings menu toggles' defaults
	$PopupBackground/Popup/Pages/Settings/CheatCode.set_pressed_no_signal(GameData.settings.get(\"cheat_code\"))
	$PopupBackground/Popup/Pages/Settings/SuperJump.set_pressed_no_signal(GameData.settings.get(\"super_jump\"))
	$PopupBackground/Popup/Pages/Settings/PlayerAnimation.set_pressed_no_signal(GameData.settings.get(\"player_animation\"))
	
	# Settings menu toggles' listeners
	$PopupBackground/Popup/Pages/Settings/CheatCode.toggled.connect(func(toggled_on: bool): GameData.settings.set(\"cheat_code\", toggled_on))
	$PopupBackground/Popup/Pages/Settings/SuperJump.toggled.connect(func(toggled_on: bool): GameData.settings.set(\"super_jump\", toggled_on))
	$PopupBackground/Popup/Pages/Settings/SuperJump.toggled.connect(func(toggled_on: bool): GameData.settings.set(\"player_animation\", toggled_on))
func show_first_menu(which: int) -> void:
	menus.push_back(which)
	show_menu(which)
func show_menu(which: int) -> void:
	if (!$PopupBackground.visible): $PopupBackground.show()
	var page_node: Control = $PopupBackground/Popup/Pages.get_child(which)
	page_node.show()
func change_menu() -> void:
	pass
func hide_menu() -> void:
	menus.clear()
	for node: Control in $PopupBackground/Popup/Pages.get_children(false):
		node.hide()
	$PopupBackground.hide()

func _unhandled_key_input(event: InputEvent) -> void:
	play()
func play() -> void:
	get_tree().change_scene_to_file(\"res://level1.tscn\")

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass
"

