[sub_resource type="GDScript" id="GDScript_85llr"]
script/source = "extends CharacterBody2D


const SPEED = 400.0
const JUMP_VELOCITY = -600.0
const NEXT_SCENE = \"res://level2.tscn\"

# Half values for zone calculation
const WIDTH = 36
const HEIGHT = 45

# Screen size
const SCREEN_WIDTH = 1152
const SCREEN_HEIGHT = 648


func _physics_process(delta: float) -> void:
	# Add the gravity.
	if not is_on_floor():
		velocity += get_gravity() * delta

	# Handle jump.
	if Input.is_action_just_pressed(\"ui_accept\") and is_on_floor():
		velocity.y = JUMP_VELOCITY

	# Get the input direction and handle the movement/deceleration.
	# As good practice, you should replace UI actions with custom gameplay actions.
	var direction := Input.get_axis(\"ui_left\", \"ui_right\")
	if direction:
		velocity.x = direction * SPEED
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)
	
	if (self.global_position.x + WIDTH > SCREEN_WIDTH + (WIDTH * 2)):
		get_tree().change_scene_to_file(NEXT_SCENE)
		
	if (self.global_position.x - WIDTH < -(WIDTH * 2)):
		get_tree().change_scene_to_file(\"res://level1.tscn\")
		
	if (self.global_position.y + HEIGHT >= 540):
		await get_tree().create_timer(0.1).timeout
		get_tree().reload_current_scene()
	
	move_and_slide()
"

