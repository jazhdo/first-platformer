[sub_resource type="GDScript" id="GDScript_85llr"]
script/source = "extends CharacterBody2D

const SPEED = 400.0
const JUMP_VELOCITY = -550.0
const SUPER_JUMP_VELOCITY = -650.0

# Half values for zone calculation
const WIDTH = 36
const HEIGHT = 45

# Screen size
const SCREEN_WIDTH = 1152
const SCREEN_HEIGHT = 648

class Level:
	var name: String
	var path: String
	
	func _init(name: String, path: String = \"res://level\" + name + \".tscn\") -> void:
		self.name = name
		self.path = path

var LEVELS: Array[Level] = [
	Level.new(\"1\"),
	Level.new(\"2\"),
	Level.new(\"3\"),
	Level.new(\"4\"),
	Level.new(\"5\"),
	Level.new(\"6\"),
	Level.new(\"Win\", \"res://final_level.tscn\")
]

enum State {
	DEAD,
	ALIVE
}
var state = State.ALIVE

func get_level(previous: bool) -> String:
	var current_level: int = LEVELS.find_custom(func(item): return item.path == get_tree().current_scene.scene_file_path)
	if (current_level == -1):
		print(\"ERROR: Level \" + get_tree().current_scene.scene_file_path + \" not found.\")
		return LEVELS[0].path
	
	return LEVELS[[current_level + 1, current_level, current_level - 1, 0][(int(previous) << 1) | int(current_level == (0 if previous else LEVELS.size() - 1))]].path

func _physics_process(delta: float) -> void:
	if state == State.DEAD or get_tree().current_scene is not Node2D:
		return
	
	# Add the gravity.
	if not is_on_floor():
		velocity += get_gravity() * delta
	
	# Handle jump & super jump
	if Input.is_action_just_pressed(\"up\") and is_on_floor():
		velocity.y = SUPER_JUMP_VELOCITY if GameData.settings.get(\"super_jump\") and Input.is_key_pressed(Key.KEY_SHIFT) else JUMP_VELOCITY
	
	# Handle level skip cheat code
	if GameData.settings.get(\"cheat_code\") and are_all_pressed([Key.KEY_E, Key.KEY_R, Key.KEY_END]):
		GameData.load_direction = false
		spawn()
	
	# Get the input direction and handle the movement/deceleration.
	var direction := Input.get_axis(\"left\", \"right\")
	if direction:
		velocity.x = direction * SPEED
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)
	
	move_and_slide()
	
	if global_position.x + WIDTH > SCREEN_WIDTH + (WIDTH * 2):
		get_tree().change_scene_to_file(get_level(false))
		GameData.load_direction = true
		
	if global_position.x - WIDTH < -(WIDTH * 2):
		get_tree().change_scene_to_file(get_level(true))
		GameData.load_direction = false
		

func _ready() -> void:
	# Only add game level triggers if in a game level
	if get_tree().current_scene is Node2D:
		spawn()
		$Area2D.body_entered.connect(kill)
	if GameData.settings.get(\"player_animation\"): $Animation.play(\"default\")
	
	$Overlay/DeathScreen/RespawnButton.pressed.connect(respawn)
	
	var current_level: int = LEVELS.find_custom(func(item): return item.path == get_tree().current_scene.scene_file_path)
	$Overlay/Info/LevelDisplay/Level.text = \"Level: \" + LEVELS[current_level].name
	$Overlay/Info/LevelDisplay/ProgressBar.value = current_level
	
	$Overlay/Info/SettingsBackground/Button.pressed.connect(
		func():
			GameData.load_direction = true
			get_tree().change_scene_to_file(\"res://main_menu.tscn\")
	)

func spawn() -> void:
	global_position = get_tree().get_nodes_in_group(\"spawns\")[int(!GameData.load_direction)].global_position

func kill(body: Node2D) -> void:
	if GameData.settings.get(\"instant_respawn\") == false: state = State.DEAD
	await get_tree().create_timer(0.05).timeout
	if GameData.settings.get(\"instant_respawn\") == true: spawn()
	else:
		$Animation.pause()
		$Overlay/DeathScreen.show()

func respawn() -> void:
	$Overlay/DeathScreen.hide()
	spawn()
	$Animation.play(\"default\")
	state = State.ALIVE

func are_all_pressed(key_array: Array[Key]) -> bool:
	for key: Key in key_array:
		if not Input.is_key_pressed(key): return false
	return true
func are_any_pressed(key_array: Array[Key]) -> bool:
	for key: Key in key_array:
		if Input.is_key_pressed(key): return true
	return false

func _unhandled_key_input(event: InputEvent) -> void:
	if state == State.DEAD and are_any_pressed([Key.KEY_ENTER, Key.KEY_SPACE]): respawn()
"

