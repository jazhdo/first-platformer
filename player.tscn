[sub_resource type="GDScript" id="GDScript_85llr"]
script/source = "extends CharacterBody2D


const SPEED = 400.0
const JUMP_VELOCITY = -550.0
const NEXT_SCENE = \"res://level2.tscn\"

# Half values for zone calculation
const WIDTH = 36
const HEIGHT = 45

# Screen size
const SCREEN_WIDTH = 1152
const SCREEN_HEIGHT = 648

const LEVELS = [
	\"res://level1.tscn\",
	\"res://level2.tscn\",
	\"res://level3.tscn\"
]

func get_level(previous: bool) -> String:
	var current_level: int = LEVELS.find(get_tree().current_scene.scene_file_path)
	if (current_level == -1):
		print(\"ERROR: Level \" + get_tree().current_scene.scene_file_path + \" not found.\")
		return LEVELS[0]
	
	return LEVELS[[current_level + 1, current_level, current_level - 1, 0][(int(previous) << 1) | int(current_level == (0 if previous else LEVELS.size() - 1))]]

func _physics_process(delta: float) -> void:
	# Add the gravity.
	if not is_on_floor():
		velocity += get_gravity() * delta

	# Handle jump.
	if Input.is_action_just_pressed(\"up\") and is_on_floor():
		velocity.y = JUMP_VELOCITY

	# Get the input direction and handle the movement/deceleration.
	var direction := Input.get_axis(\"left\", \"right\")
	if direction:
		velocity.x = direction * SPEED
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)

	move_and_slide()
	
	if (global_position.x + WIDTH > SCREEN_WIDTH + (WIDTH * 2)):
		get_tree().change_scene_to_file(get_level(false))
		GameData.load_direction = true
		
	if (global_position.x - WIDTH < -(WIDTH * 2)):
		get_tree().change_scene_to_file(get_level(true))
		GameData.load_direction = false
		

func _ready() -> void:
	if (GameData.load_direction):
		global_position = get_tree().get_nodes_in_group(\"spawns\")[0].global_position
	else:
		global_position = get_tree().get_nodes_in_group(\"spawns\")[1].global_position
	$Area2D.body_entered.connect(kill)

func kill(body: Node2D) -> void:
	await get_tree().create_timer(0.05).timeout
	global_position = get_tree().get_nodes_in_group(\"spawns\")[0].global_position
"

